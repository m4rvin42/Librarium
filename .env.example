PORT=3000
DATABASE_PATH=/data/librarium.sqlite
DATA_DIRECTORY=/data
TZ=Europe/Berlin

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
API_TOKEN=
COOKIE_SECURE=false

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
# Optional model for the OpenAI web-search ISBN fallback; defaults to OPENAI_VISION_MODEL.
OPENAI_METADATA_MODEL=
# Optional model for metadata-only recommendation reranking; defaults to OPENAI_METADATA_MODEL.
OPENAI_RECOMMENDATION_MODEL=
OPENAI_IMAGE_ANALYSIS_ENABLED=true

METADATA_PROVIDERS=openlibrary,googlebooks
OPENLIBRARY_CONTACT_EMAIL=
GOOGLE_BOOKS_API_KEY=
# Required only to save a Google Books key through Settings. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
MAX_IMAGE_SIZE_MB=15
# Optional comma-separated public hostnames/origins accepted by browser-based MCP clients.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
